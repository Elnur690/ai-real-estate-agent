# Application Branding & Core Configuration
PROJECT_NAME="RealEstate AI Agent"
SECRET_KEY="generate-with-python-secrets-token-urlsafe"
ENCRYPTION_KEY="generate-with-python-secrets-token-urlsafe"

# SaaS Admin Credentials
ADMIN_EMAIL=admin@erma.shop
ADMIN_PASSWORD=your_strong_admin_password_here


# Allowed Domains & CORS Configuration
ALLOWED_HOSTS="realtor.erma.shop,realtor-api.erma.shop,localhost,127.0.0.1"
BACKEND_CORS_ORIGINS='["https://realtor.erma.shop","http://realtor.erma.shop","https://realtor-api.erma.shop","http://realtor-api.erma.shop","http://localhost:23300","http://localhost:23800","*"]'

# Database Credentials & Passwords
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_generated_password_here
POSTGRES_DB=realestate
DATABASE_URL=postgresql+asyncpg://postgres:your_strong_generated_password_here@db:5432/realestate
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:your_strong_generated_password_here@db:5432/realestate

# Redis & Celery
REDIS_URL=redis://redis:6379/0

# AI Provider API Keys (Optional - Fallbacks to Gemini Free Tier or Heuristic Rules)
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Telegram Bot Token (Get from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Evolution API (WhatsApp Integration) & Webhooks
EVOLUTION_API_URL=http://localhost:23880
EVOLUTION_API_KEY=your_strong_generated_api_key_here
EVOLUTION_INSTANCE_NAME=realestate_agent
WEBHOOK_SECRET=your_strong_generated_webhook_secret_here

# Telegram Scraping Credentials (Get from my.telegram.org)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_telegram_api_hash_here
